  19:Core/Src/main.c **** /*
  20:Core/Src/main.c ****  * Protocol
  21:Core/Src/main.c ****  * //0x0A - length - checksum - command - {address - value} - 0x0D
  22:Core/Src/main.c ****  * 0xAA - length - checksum - command - {address - value}
  23:Core/Src/main.c ****  * {} - can be multiple until buffer size is reached
  24:Core/Src/main.c ****  * length includes everything after checksum byte
  25:Core/Src/main.c ****  * checksum is crc8 including everything after crc8 byte
  26:Core/Src/main.c ****  *
  27:Core/Src/main.c ****  * commands
  28:Core/Src/main.c ****  *	** system ** 0-9
  29:Core/Src/main.c ****  *	0 ack
  30:Core/Src/main.c ****  *	1 nak
  31:Core/Src/main.c ****  *
  32:Core/Src/main.c ****  *	** outputs ** 10-19
  33:Core/Src/main.c ****  *	10 toggle
ARM GAS  C:\Users\MINIGU~1\AppData\Local\Temp\ccgHgKDF.s 			page 2


  34:Core/Src/main.c ****  *	11 on - address - output
  35:Core/Src/main.c ****  *	12 off - address - output
  36:Core/Src/main.c ****  *	13 dim - address - output - dim value 0-255
  37:Core/Src/main.c ****  *
  38:Core/Src/main.c ****  *	** scenes ** 20-29
  39:Core/Src/main.c ****  *	20 scene toggle - address
  40:Core/Src/main.c ****  *	21 scene on - address
  41:Core/Src/main.c ****  *	22 scene off - address
  42:Core/Src/main.c ****  *	23 scene dim - address - dim value 0-255
  43:Core/Src/main.c ****  *
  44:Core/Src/main.c ****  *
  45:Core/Src/main.c ****  */
