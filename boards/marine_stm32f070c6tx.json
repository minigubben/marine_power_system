{
  "build": {
    "cpu": "cortex-m0",
    "extra_flags": "-DSTM32F0 -DSTM32F070x6",
    "f_cpu": "8000000L",
    "mcu": "stm32f070c6t6",
    "product_line": "STM32F070x6"
  },
  "debug": {
    "default_tools": [
      "stlink"
    ],
    "jlink_device": "STM32F070C6",
    "openocd_target": "stm32f0x",
    "svd_path": "STM32F0x0.svd"
  },
  "frameworks": [
    "cmsis",
    "stm32cube",
    "libopencm3"
  ],
  "name": "Marine STM32F070C6Tx",
  "url": "https://github.com/minigubben/marine_power_controller",
  "upload": {
    "maximum_ram_size": 6144,
    "maximum_size": 32768,
    "protocol": "stlink",
    "protocols": [
      "stlink",
      "cmsis-dap",
      "jlink",
      "blackmagic"
    ]
  },
  "vendor": "Custom"
}
